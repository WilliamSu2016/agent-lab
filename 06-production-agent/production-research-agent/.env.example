# Copy this file to `.env` and fill in real values locally.
# NEVER commit `.env` and NEVER put a real secret value in this file, in
# source code, in tests, or in docs. See docs/architecture.md /
# docs/deployment.md for the full reference of every variable below.

# ---------------------------------------------------------------------------
# Environment: development / test / production.
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Secrets -- required. Read ONLY from the environment, never hard-coded.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Model configuration -- required.
# ---------------------------------------------------------------------------
OPENAI_MODEL=
# development/test: optional, defaults to https://api.openai.com/v1.
# production: REQUIRED, must be set explicitly (no silent public fallback).
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Agent limits -- optional; the actual per-request limits are normally
# derived from the chosen cost/latency mode (fast/balanced/quality, see
# src/cost/policy.py) rather than these process-wide defaults.
# ---------------------------------------------------------------------------
AGENT_MAX_WORKERS=6
AGENT_MAX_ITERATIONS=3
AGENT_WORKER_TIMEOUT_SECONDS=30
AGENT_RUN_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Retry policy -- optional.
# ---------------------------------------------------------------------------
LLM_RETRY_MAX_RETRIES=2
LLM_RETRY_BACKOFF_BASE_SECONDS=1
LLM_RETRY_BACKOFF_MAX_SECONDS=20
LLM_RETRY_STATUS_CODES=408,409,429,500,502,503,504

# ---------------------------------------------------------------------------
# API layer (src/api/main.py).
# ---------------------------------------------------------------------------
# Comma-separated bearer tokens accepted by every /runs* endpoint. Required
# -- the API refuses to start "open" if this is empty.
API_AUTH_TOKENS=

API_HOST=0.0.0.0
API_PORT=8000
API_GRACEFUL_SHUTDOWN_SECONDS=30

# Production checkpointer (SQLite; swap for Postgres for multi-replica --
# see src/graph/checkpointer.py). In docker-compose.yml this path is a
# mounted named volume so checkpoints survive a container replacement.
CHECKPOINT_DB_PATH=traces/production_checkpoints.sqlite3

RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Reported by GET /runs/{id} and included in every log line/trace.
AGENT_VERSION=dev

# Default cost/latency mode for a run that does not specify one explicitly.
# One of: fast | balanced | quality (src/cost/policy.py).
DEFAULT_EXECUTION_MODE=balanced
