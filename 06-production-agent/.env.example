# Copy this file to `.env` and fill in real values locally.
# NEVER commit `.env` (it is already listed in .gitignore) and NEVER put a
# real secret value in this file, in source code, in tests, or in docs.
#
# config.load_settings() reads these environment variables; see
# docs/01-CONFIGURATION.md for the full reference, defaults, and validation
# rules for every variable below.

# ---------------------------------------------------------------------------
# Environment: at least development / test / production.
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Secrets -- required. Read ONLY from the environment, never hard-coded.
# ---------------------------------------------------------------------------
# Your OpenAI-compatible API key. Required in every environment; the process
# fails immediately with a clear error if this is missing or blank.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Model configuration -- required.
# ---------------------------------------------------------------------------
# The model name/deployment id to use for every LLM call in this project.
OPENAI_MODEL=

# The OpenAI-compatible endpoint to call.
# - development/test: optional; defaults to https://api.openai.com/v1 if unset.
# - production: REQUIRED and must be set explicitly (no silent fallback to
#   the public OpenAI endpoint -- see docs/01-CONFIGURATION.md).
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Agent limits -- optional, all have safe defaults (see config/settings.py).
# ---------------------------------------------------------------------------
# Maximum number of parallel Research Worker agents fanned out per planning
# iteration (hard cap, independent of what the Planner's LLM proposes).
AGENT_MAX_WORKERS=6

# Maximum number of Planner<->Reviewer loop iterations before the run stops
# and delivers a best-effort answer regardless of review outcome.
AGENT_MAX_ITERATIONS=3

# Wall-clock timeout (seconds) for a single Research Worker's LLM call.
AGENT_WORKER_TIMEOUT_SECONDS=30

# Overall wall-clock timeout (seconds) for one whole multi-agent run
# (Planner + all workers + Synthesizer + Reviewer, across every iteration).
AGENT_RUN_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Retry policy -- optional, all have safe defaults (see config/settings.py).
# ---------------------------------------------------------------------------
# How many additional attempts to make after the first failed LLM call, for
# retryable failures only (connection errors, timeouts, rate limits, and the
# status codes listed below). Set to 0 to disable retries entirely.
LLM_RETRY_MAX_RETRIES=2

# Exponential backoff base delay (seconds) before the first retry.
LLM_RETRY_BACKOFF_BASE_SECONDS=1

# Maximum backoff delay (seconds) the exponential schedule is capped at.
LLM_RETRY_BACKOFF_MAX_SECONDS=20

# Comma-separated HTTP status codes treated as retryable transient errors.
# Everything else (e.g. 401/403/400/404) fails immediately, never retried.
LLM_RETRY_STATUS_CODES=408,409,429,500,502,503,504

# ---------------------------------------------------------------------------
# Deployment experiment (docs/08-DEPLOYMENT.md) -- production API layer
# (src/api/main.py). Optional in development; API_AUTH_TOKENS is required
# to start the API at all (it refuses to start "open").
# ---------------------------------------------------------------------------
# Comma-separated bearer tokens accepted by every /runs* endpoint.
# NEVER a real production credential in this example file.
API_AUTH_TOKENS=

# Host/port the API binds to, and how long (seconds) graceful shutdown
# waits for in-flight runs to finish draining before the process exits.
API_HOST=0.0.0.0
API_PORT=8000
API_GRACEFUL_SHUTDOWN_SECONDS=30

# Where the production (SQLite) checkpointer's file lives. In
# docker-compose.yml this path is a mounted named volume so checkpoints
# survive a container replacement.
CHECKPOINT_DB_PATH=traces/durable_checkpoints.sqlite3

# Rate limit: max requests per user_id per rolling window.
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Reported by GET /runs/{id} and included in every log line/trace -- which
# build of the agent produced this run (Observability experiment's
# "agent_version" identifier).
AGENT_VERSION=dev

